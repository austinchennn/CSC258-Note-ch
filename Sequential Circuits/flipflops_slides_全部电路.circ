  <circuit name="SR_MasterSlave_FF">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="SR master-slave flip-flop: master open while C=1, slave copies it when C falls (negative edge). Also used by the T and JK flip-flops"/></comp>
    <comp loc="(400,180)" name="Clocked_SR_Latch"></comp>
    <comp loc="(720,280)" name="Clocked_SR_Latch"></comp>
    <comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="S"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(100,200)" name="Pin"><a name="label" val="C"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(100,400)" name="Pin"><a name="label" val="R"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="1" loc="(260,460)" name="NOT Gate"></comp>
