  <circuit name="s03_SR_Latch_NOR">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="NOR SR latch: R -&gt; Q (top), S -&gt; Qn (bottom)."/></comp>
    <comp lib="8" loc="(100,50)" name="Text"><a name="text" val="SR=00 hold, 01 Q=0, 10 Q=1, 11 forbidden"/></comp>
    <comp lib="0" loc="(100,140)" name="Pin"><a name="label" val="R"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(100,260)" name="Pin"><a name="label" val="S"/><a name="appearance" val="NewPins"/></comp>
