  <circuit name="s01_Gate_Delay">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Y = A AND B (slide: Gate delay example)"/></comp>
    <comp lib="1" loc="(250,120)" name="AND Gate"><a name="size" val="30"/></comp>
    <comp lib="0" loc="(100,110)" name="Pin"><a name="label" val="A"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(100,130)" name="Pin"><a name="label" val="B"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(350,120)" name="Pin"><a name="label" val="Y"/><a name="type" val="output"/><a name="facing" val="west"/><a name="appearance" val="NewPins"/></comp>
    <wire from="(100,110)" to="(220,110)"/>
    <wire from="(100,130)" to="(220,130)"/>
    <wire from="(250,120)" to="(350,120)"/>
  </circuit>
  <circuit name="s02_Feedback_AND">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Feedback AND: output Q fed back to input. A=0 -&gt; Q stuck at 0"/></comp>
    <comp lib="1" loc="(260,120)" name="AND Gate"><a name="size" val="30"/></comp>
    <comp lib="0" loc="(100,110)" name="Pin"><a name="label" val="A"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(360,120)" name="Pin"><a name="label" val="Q"/><a name="type" val="output"/><a name="facing" val="west"/><a name="appearance" val="NewPins"/></comp>
    <wire from="(100,110)" to="(230,110)"/>
    <wire from="(180,130)" to="(180,180)"/>
    <wire from="(180,130)" to="(230,130)"/>
    <wire from="(180,180)" to="(300,180)"/>
    <wire from="(260,120)" to="(300,120)"/>
    <wire from="(300,120)" to="(300,180)"/>
    <wire from="(300,120)" to="(360,120)"/>
  </circuit>
  <circuit name="s02_Feedback_OR">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Feedback OR: output Q fed back to input. A=1 -&gt; Q stuck at 1"/></comp>
    <comp lib="1" loc="(260,120)" name="OR Gate"><a name="size" val="30"/></comp>
    <comp lib="0" loc="(100,110)" name="Pin"><a name="label" val="A"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(360,120)" name="Pin"><a name="label" val="Q"/><a name="type" val="output"/><a name="facing" val="west"/><a name="appearance" val="NewPins"/></comp>
    <wire from="(100,110)" to="(230,110)"/>
    <wire from="(180,130)" to="(180,180)"/>
    <wire from="(180,130)" to="(230,130)"/>
    <wire from="(180,180)" to="(300,180)"/>
    <wire from="(260,120)" to="(300,120)"/>
    <wire from="(300,120)" to="(300,180)"/>
    <wire from="(300,120)" to="(360,120)"/>
  </circuit>
  <circuit name="s02_Feedback_NAND">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Feedback NAND: output Q fed back to input. A=1 -&gt; oscillates (unsteady)"/></comp>
    <comp lib="1" loc="(260,120)" name="NAND Gate"><a name="size" val="30"/></comp>
    <comp lib="0" loc="(100,110)" name="Pin"><a name="label" val="A"/><a name="appearance" val="NewPins"/></comp>
