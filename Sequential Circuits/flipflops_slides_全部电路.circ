    <wire from="(180,130)" to="(180,180)"/>
    <wire from="(180,130)" to="(220,130)"/>
    <wire from="(180,180)" to="(300,180)"/>
    <wire from="(260,120)" to="(300,120)"/>
    <wire from="(300,120)" to="(300,180)"/>
    <wire from="(300,120)" to="(360,120)"/>
  </circuit>
  <circuit name="s02_Feedback_NOR">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Feedback NOR: output Q fed back to input. A=0 -&gt; oscillates (unsteady)"/></comp>
