  <circuit name="s02_Feedback_NAND">
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Feedback NAND: output Q fed back to input. A=1 -&gt; oscillates (unsteady)"/></comp>
    <comp lib="1" loc="(260,120)" name="NAND Gate"></comp>
