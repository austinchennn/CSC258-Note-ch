  <circuit name="s01_Gate_Delay">
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Y = A AND B (slide: Gate delay example)"/></comp>
    <comp lib="1" loc="(250,120)" name="AND Gate"></comp>
    <comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="A"/><a name="appearance" val="classic"/></comp>
    <comp lib="0" loc="(100,140)" name="Pin"><a name="label" val="B"/><a name="appearance" val="classic"/></comp>
    <comp lib="0" loc="(350,120)" name="Pin"><a name="label" val="Y"/><a name="type" val="output"/><a name="facing" val="west"/><a name="appearance" val="classic"/></comp>
    <wire from="(100,100)" to="(200,100)"/>
    <wire from="(100,140)" to="(200,140)"/>
    <wire from="(250,120)" to="(350,120)"/>
  </circuit>
  <circuit name="s02_Feedback_AND">
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Feedback AND: output Q fed back to input. A=0 -&gt; Q stuck at 0"/></comp>
    <comp lib="1" loc="(260,120)" name="AND Gate"></comp>
    <comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="A"/><a name="appearance" val="classic"/></comp>
