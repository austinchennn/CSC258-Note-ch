  <circuit name="s07_Transparency_Toggle">
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="D latch with Qn fed back to D. While C=1 Q toggles endlessly (oscillation!)"/></comp>
    <comp loc="(300,200)" name="D_Latch"></comp>
