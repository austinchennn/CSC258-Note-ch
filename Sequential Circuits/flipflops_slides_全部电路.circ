    <comp lib="8" loc="(100,30)" name="Text"><a name="text" val="Four D latches in series on one clock: with C=1 the input floods through all of them"/></comp>
    <comp lib="0" loc="(100,200)" name="Pin"><a name="label" val="D"/><a name="appearance" val="NewPins"/></comp>
    <comp lib="0" loc="(100,300)" name="Pin"><a name="label" val="C"/><a name="appearance" val="NewPins"/></comp>
